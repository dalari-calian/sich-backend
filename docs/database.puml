@startuml database
' ============================================================================
' Esquema do banco de dados (PostgreSQL) - Sich Backend
' Convenção: nomes de tabelas e colunas em minúsculo, sem underscore.
' Atualize este arquivo sempre que uma tabela ou coluna for criada/alterada.
' ============================================================================

hide circle
hide methods
hide stereotypes
skinparam linetype ortho
skinparam roundcorner 6
skinparam class {
  BackgroundColor<<table>> #FFFFFF
  BorderColor #555555
  HeaderBackgroundColor #DDE7F3
}

!define table(name) entity name <<table>>
!define pk(col) <b><color:#B8860B>PK</color> col</b>
!define fk(col) <color:#1E6FD9>FK</color> col
!define uq(col) <color:#2E8B57>UQ</color> col
!define fkuq(col) <color:#1E6FD9>FK</color> <color:#2E8B57>UQ</color> col

table(users) {
  pk(id) : bigint identity NOT NULL
  --
  uq(email) : varchar(255) NOT NULL
  password : varchar(255) NOT NULL
  usertype : varchar(255) NOT NULL
  active : boolean NOT NULL
  createdat : timestamptz NOT NULL
  updatedat : timestamptz NOT NULL
  ..
  CHECK usertype IN ('CUSTOMER', 'PROVIDER', 'ADMIN')
}

table(admins) {
  pk(id) : bigint identity NOT NULL
  --
  fkuq(userid) : bigint NOT NULL
  name : varchar(255) NOT NULL
  createdat : timestamptz NOT NULL
  updatedat : timestamptz NOT NULL
  ..
  inserido direto no banco (docs/sql/admin.sql)
}

table(customers) {
  pk(id) : bigint identity NOT NULL
  --
  fkuq(userid) : bigint NOT NULL
  name : varchar(255) NOT NULL
  phone : varchar(255) NOT NULL
  cnpjcpf : varchar(255) NULL
  city : varchar(255) NULL
  state : varchar(255) NULL
  street : varchar(255) NULL
  complementadress : varchar(255) NULL
  neighborhood : varchar(255) NULL
  cep : varchar(255) NULL
  numberadress : varchar(255) NULL
  createdat : timestamptz NOT NULL
  updatedat : timestamptz NOT NULL
}

table(providers) {
  pk(id) : bigint identity NOT NULL
  --
  fkuq(userid) : bigint NOT NULL
  name : varchar(255) NOT NULL
  phone : varchar(255) NOT NULL
  cnpjcpf : varchar(255) NULL
  city : varchar(255) NULL
  state : varchar(255) NULL
  street : varchar(255) NULL
  complementadress : varchar(255) NULL
  neighborhood : varchar(255) NULL
  cep : varchar(255) NULL
  numberadress : varchar(255) NULL
  createdat : timestamptz NOT NULL
  updatedat : timestamptz NOT NULL
}

table(categories) {
  pk(id) : bigint identity NOT NULL
  --
  uq(name) : varchar(120) NOT NULL
  description : text NULL
  createdat : timestamptz NOT NULL
  updatedat : timestamptz NOT NULL
  ..
  cadastrada apenas pelo ADMIN
}

table(products) {
  pk(id) : bigint identity NOT NULL
  --
  fk(providerid) : bigint NOT NULL
  fk(categoryid) : bigint NOT NULL
  name : varchar(120) NOT NULL
  description : text NULL
  price : numeric(10,2) NOT NULL
  durationminutes : integer NOT NULL
  active : boolean NOT NULL DEFAULT true
  createdat : timestamptz NOT NULL
  updatedat : timestamptz NOT NULL
  ..
  cadastrado apenas pelo PROVIDER (dono)
  durationminutes: tela exibe HH:MM (até 99:59)
  active: true = ativo, false = inativo
}

table(productimages) {
  pk(id) : bigint identity NOT NULL
  --
  fk(productid) : bigint NOT NULL
  image : text NOT NULL
  createdat : timestamptz NOT NULL
  updatedat : timestamptz NOT NULL
  ..
  data URL base64 (png/jpeg/webp, até 2 MB)
  máximo 5 por produto
  ON DELETE CASCADE (apaga com o produto)
}

table(providerworkinghours) {
  pk(id) : bigint identity NOT NULL
  --
  fk(providerid) : bigint NOT NULL
  weekday : integer NOT NULL
  starttime : time NOT NULL
  endtime : time NOT NULL
  createdat : timestamptz NOT NULL
  updatedat : timestamptz NOT NULL
  ..
  um intervalo de trabalho por linha (almoço = espaço entre dois)
  weekday: 1 = segunda ... 7 = domingo (java.time.DayOfWeek)
  horários múltiplos de 15 min; CHECK endtime > starttime
}

table(appointments) {
  pk(id) : bigint identity NOT NULL
  --
  fk(providerid) : bigint NOT NULL
  fk(customerid) : bigint NULL
  customername : varchar(120) NULL
  startat : timestamp NOT NULL
  endat : timestamp NOT NULL
  totalminutes : integer NOT NULL
  totalprice : numeric(12,2) NOT NULL
  notes : varchar(400) NULL
  status : varchar(20) NOT NULL
  origin : varchar(20) NOT NULL
  canceledat : timestamptz NULL
  canceledby : varchar(20) NULL
  createdat : timestamptz NOT NULL
  updatedat : timestamptz NOT NULL
  ..
  startat/endat: hora local do prestador, período [startat, endat)
  status: SCHEDULED | CANCELED; origin/canceledby: PROVIDER | CUSTOMER
  customername só quando não há customerid (cliente sem cadastro)
  EXCLUDE sem sobreposição por prestador (docs/sql/appointments-constraints.sql)
}

table(appointmentitems) {
  pk(id) : bigint identity NOT NULL
  --
  fk(appointmentid) : bigint NOT NULL
  fk(productid) : bigint NULL
  productname : varchar(120) NOT NULL
  price : numeric(10,2) NOT NULL
  durationminutes : integer NOT NULL
  position : integer NOT NULL
  createdat : timestamptz NOT NULL
  updatedat : timestamptz NOT NULL
  ..
  cópia do produto no momento do agendamento
  ON DELETE CASCADE (appointment); ON DELETE SET NULL (product)
}

' --- Chaves estrangeiras ---------------------------------------------------
' Notação pé-de-galinha: ||  exatamente um | o| zero ou um | o{ zero ou muitos

users ||--o| customers : "customers.userid → users.id"
users ||--o| providers : "providers.userid → users.id"
users ||--o| admins : "admins.userid → users.id"
providers ||--o{ products : "products.providerid → providers.id"
categories ||--o{ products : "products.categoryid → categories.id"
products ||--o{ productimages : "productimages.productid → products.id"
providers ||--o{ providerworkinghours : "providerworkinghours.providerid → providers.id"
providers ||--o{ appointments : "appointments.providerid → providers.id"
customers |o--o{ appointments : "appointments.customerid → customers.id"
appointments ||--|{ appointmentitems : "appointmentitems.appointmentid → appointments.id"
products |o--o{ appointmentitems : "appointmentitems.productid → products.id"

legend right
  <b><color:#B8860B>PK</color></b> chave primária
  <color:#1E6FD9>FK</color> chave estrangeira
  <color:#2E8B57>UQ</color> restrição UNIQUE
  timestamptz = timestamp with time zone
endlegend

@enduml
